#!/usr/bin/env bash

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null; then
    echo 'Install gitleaks from https://github.com/gitleaks/gitleaks/releases and rerun the commit.' >&2
    exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner
python3 scripts/ci.py files
if git diff --cached --name-only --diff-filter=ACMR -- '*.kt' '*.kts' 'gradle.properties' 'gradle/**' 'gradle.lockfile' | grep -q .; then
    ./gradlew --console=plain ktlintCheck detekt compileTestKotlinJvm
fi
